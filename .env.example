# FICTIONAL local development configuration. Supply your own passwords; never commit .env.
CUSTOMEROPS_APP_NAME="CustomerOps AI"
CUSTOMEROPS_ENVIRONMENT=development
CUSTOMEROPS_DATABASE_HOST=localhost
CUSTOMEROPS_DATABASE_PORT=5432
CUSTOMEROPS_DATABASE_NAME=customerops
CUSTOMEROPS_DATABASE_USER=customerops
CUSTOMEROPS_DATABASE_PASSWORD=
CUSTOMEROPS_DATABASE_POOL_SIZE=5
CUSTOMEROPS_DATABASE_MAX_OVERFLOW=5
CUSTOMEROPS_DATABASE_TIMEOUT=5

# Separate ephemeral test service. Set both passwords before using Compose.
CUSTOMEROPS_TEST_DATABASE_PASSWORD=
# Integration tests read this from the process environment, not automatically from .env.
# URL-encode reserved characters in the test URL password.
# CUSTOMEROPS_TEST_DATABASE_URL=postgresql+asyncpg://customerops_test:<encoded-password>@127.0.0.1:55432/customerops_test

# Agent is disabled until a key, model, and server-managed customer token mapping are supplied.
OPENAI_API_KEY=
# Choose a Responses/function-calling model available to your OpenAI project. No model is assumed.
CUSTOMEROPS_AGENT_MODEL=
CUSTOMEROPS_AGENT_PROVIDER_TIMEOUT=20
CUSTOMEROPS_AGENT_TURN_TIMEOUT=45
CUSTOMEROPS_AGENT_TOOL_TIMEOUT=5
CUSTOMEROPS_AGENT_MAX_ITERATIONS=6
CUSTOMEROPS_AGENT_MAX_TOOL_CALLS=12
CUSTOMEROPS_AGENT_MAX_OUTPUT_TOKENS=1500
CUSTOMEROPS_AGENT_HISTORY_MESSAGES=20
CUSTOMEROPS_AGENT_TICKETS_PER_HOUR=3
# JSON map of SHA-256 token fingerprints to existing customer UUIDs. Never put raw tokens here.
CUSTOMEROPS_AUTH_TOKEN_CUSTOMERS={}

# Separate SHA-256 fingerprints of high-entropy administrator bearer tokens.
CUSTOMEROPS_AUTH_ADMIN_TOKEN_HASHES=[]
# Disabled until explicitly enabled with OPENAI_API_KEY; embeddings incur API costs.
CUSTOMEROPS_RAG_ENABLED=false
CUSTOMEROPS_RAG_STORAGE_PATH=.local/rag
CUSTOMEROPS_RAG_EMBEDDING_MODEL=text-embedding-3-small
CUSTOMEROPS_RAG_EMBEDDING_DIMENSIONS=1536
CUSTOMEROPS_RAG_EMBEDDING_BATCH_SIZE=16
CUSTOMEROPS_RAG_EMBEDDING_TIMEOUT=20
CUSTOMEROPS_RAG_CHUNK_SIZE=1000
CUSTOMEROPS_RAG_CHUNK_OVERLAP=150
CUSTOMEROPS_RAG_TOP_K=4
CUSTOMEROPS_RAG_MAX_DISTANCE=0.35
CUSTOMEROPS_RAG_MAX_UPLOAD_BYTES=5242880
CUSTOMEROPS_RAG_MAX_PAGES=100
CUSTOMEROPS_RAG_MAX_TEXT_CHARACTERS=200000
CUSTOMEROPS_RAG_MAX_CHUNKS=500

# Persistent conversation memory. AGENT_HISTORY_MESSAGES limits recent text rows (0 disables replay).
CUSTOMEROPS_MEMORY_HISTORY_MAX_CHARACTERS=24000
CUSTOMEROPS_MEMORY_HISTORY_MESSAGE_CHARACTERS=4000
CUSTOMEROPS_MEMORY_SUMMARY_ENABLED=true
CUSTOMEROPS_MEMORY_SUMMARY_MAX_CHARACTERS=2000
CUSTOMEROPS_MEMORY_SUMMARY_MAX_EXCERPTS=8
CUSTOMEROPS_MEMORY_SUMMARY_EXCERPT_CHARACTERS=200
CUSTOMEROPS_MEMORY_SUMMARY_SCAN_MESSAGES=200
CUSTOMEROPS_MEMORY_PERSIST_TOOL_AUDIT=true
# Read visibility is immediate; run the explicit retention command for physical cleanup.
CUSTOMEROPS_MEMORY_MESSAGE_RETENTION_DAYS=30
CUSTOMEROPS_MEMORY_TOOL_RETENTION_DAYS=7
CUSTOMEROPS_MEMORY_CONVERSATION_RETENTION_DAYS=90
